{
  "name": "desktop-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "바탕화면을 자유롭게 돌아다니는 픽셀 캐릭터 데스크톱 펫",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lincoln.desktoppet",
    "productName": "Desktop Pet",
    "icon": "build/icon.png",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Desktop Pet"
    },
    "portable": {
      "artifactName": "DesktopPet-portable-${version}.exe"
    }
  }
}
